# WhatsApp AI assistant — Twilio (console.twilio.com)
# Solo el auth token: se usa para validar la firma del webhook (localmente,
# sin llamar a la API REST de Twilio), no para enviar mensajes.
TWILIO_AUTH_TOKEN=

# Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Opcional, por defecto gemini-flash-lite-latest
GEMINI_MODEL=

# Postgres — Netlify no trae una base integrada, hay que crear una externa
# (ej. Neon, neon.tech, plan gratuito) y pegar aquí su connection string.
DATABASE_URL=
