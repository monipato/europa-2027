# WhatsApp AI assistant — Meta for Developers (developers.facebook.com)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Palabra secreta que tú defines; debe coincidir con el "Verify token" del webhook en Meta
WHATSAPP_VERIFY_TOKEN=
# Meta for Developers → tu app → Settings → Basic → App Secret
WHATSAPP_APP_SECRET=

# Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Opcional, por defecto gemini-3.6-flash
GEMINI_MODEL=

# Postgres — Netlify no trae una base integrada, hay que crear una externa
# (ej. Neon, neon.tech, plan gratuito) y pegar aquí su connection string.
DATABASE_URL=
