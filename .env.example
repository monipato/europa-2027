# WhatsApp AI assistant — Twilio (console.twilio.com)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Formato "whatsapp:+<numero>", ej. "whatsapp:+573001234567"
TWILIO_WHATSAPP_NUMBER=

# Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Opcional, por defecto gemini-2.5-flash
GEMINI_MODEL=

# Postgres — Netlify no trae una base integrada, hay que crear una externa
# (ej. Neon, neon.tech, plan gratuito) y pegar aquí su connection string.
DATABASE_URL=
